# Copy to `.env` and fill in. (.env is git-ignored; this template is committed.)

# === Required ===
# OpenRouter API key — powers BOTH the chat LLM (google/gemma-4-31b-it) and embeddings (bge-m3).
OPEN_ROUTER=sk-or-...

# Supabase project. SUPABASE_URL is used to derive the project ref for the DB connection.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<supabase-anon-or-service-key>
SUPABASE_PASSWORD=<supabase-database-password>

# === Optional: LangSmith tracing (leave blank to disable) ===
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=fahmai

# === Optional: DB connection overrides ===
# Defaults (in fahmai/db.py) target the Supabase session pooler and derive the user as
# postgres.<project-ref>, so you normally DON'T need these. Set them only to point elsewhere.
# SUPABASE_DB_HOST=aws-1-ap-southeast-1.pooler.supabase.com
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_PORT=5432
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/postgres   # full override, wins if set

# === Optional: agent knobs (defaults in fahmai/agents/config.py) ===
# FAHMAI_MODEL=google/gemma-4-31b-it
# FAHMAI_CONCURRENCY=3
# FAHMAI_Q_TIMEOUT=600
# FAHMAI_DOC_K=3
